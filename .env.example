# Airia Sentinel — Environment Variables

# Airia SDK
AIRIA_API_KEY=your_airia_api_key_here
AIRIA_MARKET_PIPELINE_ID=
AIRIA_CORPORATE_PIPELINE_ID=
AIRIA_CONSENSUS_PIPELINE_ID=
AIRIA_COMPLIANCE_PIPELINE_ID=

# Airia Deployments (created by setup_airia_pipelines.py)
AIRIA_MARKET_DEPLOYMENT_ID=
AIRIA_CORPORATE_DEPLOYMENT_ID=
AIRIA_CORPORATE_DEPLOYMENT_ID=
AIRIA_CONSENSUS_DEPLOYMENT_ID=
AIRIA_COMPLIANCE_DEPLOYMENT_ID=

# Airia Tools (created automatically)
AIRIA_HITL_TOOL_ID=
AIRIA_SCANNER_TOOL_ID=
AIRIA_REPORT_TOOL_ID=

# LM Studio Cluster
LM_STUDIO_URL=http://127.0.0.1:1234
OLLAMA_URL=http://127.0.0.1:11434

# MEXC API (market data)
MEXC_API_KEY=
MEXC_SECRET_KEY=

# HITL Webhook
HITL_WEBHOOK_URL=
HITL_PORT=8900
